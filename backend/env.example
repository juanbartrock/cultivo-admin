# Server
PORT=4000
NODE_ENV=development

# Database (Supabase/Neon PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD_URL_ENCODED]@[HOST]:5432/postgres"

# Supabase Storage
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_KEY="your_supabase_anon_or_service_key"
SUPABASE_BUCKET_NAME="grow-photos"

# Internal Microservices (Docker Network DNS)
MS_SONOFF_URL="http://sonoff-service:3000"
MS_TUYA_URL="http://tuya-service:3000"
MS_TAPO_URL="http://tapo-service:3000"
MS_TAPO_PUBLIC_URL="http://localhost:3003"

# Auth
JWT_SECRET="your_long_random_jwt_secret_at_least_32_chars"
ADMIN_USER="admin"
ADMIN_PASSWORD="your_admin_password"

# API / Realtime
CORS_ALLOWED_ORIGINS="http://localhost:3001"
REALTIME_ALLOW_GUEST="false"

# Weather - Open-Meteo (Free, no API key required!)
# Coordinates for Buenos Aires, Argentina
WEATHER_LATITUDE="-34.6037"
WEATHER_LONGITUDE="-58.3816"
WEATHER_LOCATION_NAME="Buenos Aires, Argentina"

# Google Gemini (for AI assistant - FREE tier available)
GEMINI_API_KEY="your_gemini_api_key_here"

# Google Cloud Text-to-Speech (for voice - Chirp3-HD FREE tier)
GOOGLE_CLOUD_TTS_API_KEY="your_google_cloud_tts_api_key_here"
